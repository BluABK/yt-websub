[Unit]
Description=YouTube WebSub (PubSubHubbub) notification server
After=network-online.target
Wants=network-online.target
# If the process crash-loops (restarts 10 times within 5 minutes) stop retrying
# and surface a failed unit for monitoring/alerting, instead of flapping silently
# forever. A transient crash still self-heals. To prefer availability over
# surfacing (never give up), set StartLimitIntervalSec=0.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=yt-websub
Group=yt-websub
EnvironmentFile=/etc/yt-websub.env
ExecStart=/usr/local/bin/yt-websub
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yt-websub

# Persistent state -> /var/lib/yt-websub, created and owned by the service user.
# 0750 dir + 0077 umask keep subs.tsv (per-sub HMAC secrets + callback tokens),
# resolve.cache, and the copied TLS key from being world-readable.
StateDirectory=yt-websub
StateDirectoryMode=0750
UMask=0077

# Bind :443 without full root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Sandboxing.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/yt-websub
# Cert + key are copied into /var/lib/yt-websub by the certbot deploy hook, so
# no access to /etc/letsencrypt is needed here.
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
