# yt-websub configuration. Copy to /etc/yt-websub.env (chmod 0640, owner root:yt-websub).
# Process environment variables of the same name override these values.

# Public base URL the YouTube hub will call back. Must be your real domain on
# the Let's Encrypt cert. The per-subscription callback path is appended as
# /yt/cb/<token>, so just set the scheme+host here.
YTWEBSUB_CALLBACK_BASE=https://hooks.example.com

# Single HTTPS listener (serves both the callback and /api). Port 443 needs
# CAP_NET_BIND_SERVICE (granted by the systemd unit).
YTWEBSUB_LISTEN=0.0.0.0:443

# TLS cert + key. A certbot deploy hook copies the Let's Encrypt material here
# readable by the yt-websub user on each renewal (see README). Point these at
# those copies, not directly at /etc/letsencrypt (root-only).
YTWEBSUB_TLS_CERT=/var/lib/yt-websub/cert.pem
YTWEBSUB_TLS_KEY=/var/lib/yt-websub/key.pem

# Shared secret streamarchiver presents as "Authorization: Bearer <token>".
# Generate once: openssl rand -hex 32
YTWEBSUB_BEARER_TOKEN=CHANGE_ME_long_random_token

# Operator-managed desired channel list (one UC.../@handle/URL per line).
YTWEBSUB_CHANNELS_FILE=/var/lib/yt-websub/channels.txt

# Durable state directory (events.log, subs.tsv, ack.txt, resolve.cache).
YTWEBSUB_STORAGE_DIR=/var/lib/yt-websub

# Lease length to request from the hub (seconds). 432000 = 5 days.
YTWEBSUB_LEASE_SECONDS=432000

# WebSub hub endpoint (rarely changed).
YTWEBSUB_HUB_URL=https://pubsubhubbub.appspot.com/subscribe

# Accept-loop thread count.
YTWEBSUB_ACCEPT_THREADS=4
